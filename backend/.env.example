# Copy to backend/.env (or export in your shell) before starting the API.
# The API works fully WITHOUT this key — Gemini only enriches the
# "why this comes next" narrative and calibrates effort hours.

GEMINI_API_KEY=
# Optional overrides
# CF_GEMINI_MODEL=gemini-2.0-flash
# CF_RANKER=keyword            # or: embedding
# CF_USE_EMBEDDINGS=1          # requires: pip install fastembed
# CF_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# CF_FRONTEND_DIR=../frontend/out
